# Single source of truth for ALL environment variables.
# Copy this file to .env — never commit real secrets.
#
# ── Docker note ───────────────────────────────────────────────────────────────
# The values below work for local development (pnpm dev or docker compose up).
# When running docker-compose.build.yml (production), the compose file
# overrides DATABASE_URL, REDIS_URL, and MINIO_ENDPOINT automatically to use
# Docker service hostnames. You do NOT need separate env files.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=local

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=file-processing-platform-db
POSTGRES_PORT=5432
# Local / pnpm dev value. Docker compose overrides this to use the service name.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/file-processing-platform-db

# ── Redis ──────────────────────────────────────────────────────────────────
# Local / pnpm dev value. Docker compose overrides this to redis://redis:6379.
REDIS_URL=redis://localhost:6379

# ── API server ─────────────────────────────────────────────────────────────
API_CONTAINER_PORT=3001
WEB_CONTAINER_PORT=5173
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# ── Docker Port Exposure (development only) ────────────────────────────────
# Maps container ports to host OS ports. Customize these to avoid conflicts.
# Public-facing services:
WEB_PORT=3000
API_PORT=3001
# Database and cache services (for debugging access from host):
POSTGRES_PORT=3002
REDIS_PORT=3003
MINIO_PORT=3004
MINIO_CONSOLE_PORT=3005

# ── JWT (generate with: openssl rand -hex 32) ──────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_REFRESH_SECRET=change-me-to-another-random-string-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ── Auth ───────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── File storage ───────────────────────────────────────────────────────────
MAX_FILE_SIZE_BYTES=52428800
# TTL for presigned upload URLs handed to the browser.
PRESIGNED_URL_TTL_SECONDS=900
# How long a "pending" (reserved but never confirmed) upload survives before
# the worker's cleanup sweep deletes it.
PENDING_UPLOAD_TTL_SECONDS=3600
PENDING_UPLOAD_CLEANUP_INTERVAL_SECONDS=900

# ── MinIO ──────────────────────────────────────────────────────────────────
# Local / pnpm dev value. Docker compose overrides MINIO_ENDPOINT to "minio".
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-to-a-secure-password
MINIO_BUCKET=uploads
# Browser-facing MinIO origin — must be reachable from the client, unlike
# MINIO_ENDPOINT which is an internal Docker service name in compose.
MINIO_PUBLIC_URL=http://localhost:3004

# ── Web (Vite) ─────────────────────────────────────────────────────────────
VITE_API_BASE_URL=/api