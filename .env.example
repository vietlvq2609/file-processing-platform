# Shared infrastructure — loaded by all apps and docker-compose.
# App-specific secrets live in each app's own .env file.
# Copy this file to .env — never commit real secrets.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=local

# ── PostgreSQL (used by docker-compose and apps via DATABASE_URL) ───────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=file-processing-platform-db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/file-processing-platform-db

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379