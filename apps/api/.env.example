# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/file-processing-platform-db

# JWT — use strong random secrets in production (openssl rand -hex 64)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# CORS — frontend origin
CORS_ORIGIN=http://localhost:5173

# File storage
STORAGE_PATH=./uploads

# Runtime
NODE_ENV=development
PORT=3000
