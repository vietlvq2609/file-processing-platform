# API-specific vars. Copy this file to .env — never commit real secrets.
# Shared infra (DATABASE_URL, REDIS_URL, NODE_ENV) is loaded from the
# root .env automatically — only set them here to override.

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# ── JWT (generate with: openssl rand -hex 32) ─────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_REFRESH_SECRET=change-me-to-another-random-string-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ── Auth ──────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── File storage ──────────────────────────────────────────────────────────
STORAGE_PATH=./uploads
MAX_FILE_SIZE_BYTES=52428800
