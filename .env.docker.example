# Environment variables for the full production stack (docker-compose.prod.yml).
# Copy this file to .env at the repo root and fill in the secrets.
# Never commit the real .env file.

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=file-processing-platform-db
POSTGRES_PORT=5432

# ── API ────────────────────────────────────────────────────────────────────
NODE_ENV=production

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_REFRESH_SECRET=change-me-to-another-random-string-of-at-least-32-characters

JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
BCRYPT_ROUNDS=12
MAX_FILE_SIZE_BYTES=52428800

# CORS origin must match the URL the browser uses to reach the web container.
# If WEB_PORT is 80 this should be http://localhost.
CORS_ORIGIN=http://localhost

# ── Web ────────────────────────────────────────────────────────────────────
# Host port that the nginx container will bind to.
WEB_PORT=80
