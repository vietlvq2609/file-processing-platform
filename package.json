{
  "name": "file-processing-platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web,worker -c blue,green,yellow \"pnpm --filter @fpp/api dev\" \"pnpm --filter @fpp/web dev\" \"pnpm --filter @fpp/worker dev\"",
    "dev:api": "pnpm --filter @fpp/api dev",
    "dev:web": "pnpm --filter @fpp/web dev",
    "dev:worker": "pnpm --filter @fpp/worker dev",
    "build": "pnpm --filter @fpp/db build && pnpm --filter @fpp/types build && pnpm --filter @fpp/api build && pnpm --filter @fpp/worker build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "start": "pnpm --filter @fpp/api start",
    "db:generate": "pnpm --filter @fpp/db generate",
    "db:migrate": "pnpm --filter @fpp/db migrate",
    "db:seed": "docker exec -i fpp-postgres psql -U postgres -d file-processing-platform-db < infra/postgres/seeds/01_test_user.sql",
    "lint": "eslint \"apps/**/src/**/*.{ts,tsx}\" \"packages/**/src/**/*.ts\"",
    "lint:fix": "eslint \"apps/**/src/**/*.{ts,tsx}\" \"packages/**/src/**/*.ts\" --fix",
    "format": "prettier --write \"apps/**/src/**/*.{ts,tsx}\" \"packages/**/src/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/src/**/*.{ts,tsx}\" \"packages/**/src/**/*.ts\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/**/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "packageManager": "pnpm@9.12.0",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.0.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.5",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.64.0"
  }
}
